{
  "name": "havoc",
  "version": "1.0.0",
  "description": "Audit your AI-built app before you ship it.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build:extension": "npm run build --prefix extension",
    "test:extension": "npm test --prefix extension",
    "test:backend": "cd backend && go test ./...",
    "test:demo": "npm test --prefix demo-app",
    "demo": "npm start --prefix demo-app",
    "demo:broken": "npm run demo:broken --prefix demo-app",
    "demo:fixed": "npm run demo:fixed --prefix demo-app"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhiix0/Havoc.git"
  },
  "keywords": [],
